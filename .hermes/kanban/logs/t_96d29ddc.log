+package com.itmeansbigmountain.rivalradar;
+
+import java.net.URI;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class RivalRadarConfigTest
+{
+	private final RivalRadarConfig config = new RivalRadarConfig()
+	{
+	};
+
+	@Test
+	public void defaultConfigMatchesDocumentedManualTestDefaults()
+	{
+		assertTrue(config.showOverlay());
+		assertEquals("", config.rivalName());
+		assertEquals("overall", config.comparisonSkill());
+		assertEquals("tracking enabled", config.welcomeMessage());
+	}
+
+	@Test
+	public void overlayDisplayValueTrimsAndFallsBack()
+	{
+		assertEquals("not set", RivalRadarOverlay.displayValue("  ", "not set"));
+		assertEquals("Oyama", RivalRadarOverlay.displayValue(" Oyama ", "not set"));
+	}
+
+	@Test
+	public void womHelperBuildsSafePublicApiUris()
+	{
+		URI playerUri = WOMApiHelper.buildPlayerUri("Rival Name");
+		URI hiscoresUri = WOMApiHelper.buildHiscoresUri("woodcutting", 250);
+
+		assertEquals("https://api.wiseoldman.net/v1/player/Rival%20Name", playerUri.toString());
+		assertEquals("https://api.wiseoldman.net/v1/hiscores/woodcutting?limit=100", hiscoresUri.toString());
+	}
+
+	@Test
+	public void xpComparisonCopyIsDeterministicWithoutNetwork()
+	{
+		assertEquals(
+			"Compare local player vs Oyama for overall XP gains using Wise Old Man.",
+			WOMApiHelper.formatXPComparison("", " Oyama ", "")
+		);
+	}
+}
