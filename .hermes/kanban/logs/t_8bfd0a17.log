+package com.itmeansbigmountain.skillnemesis;
+
+import java.util.Objects;
+
+/**
+ * Immutable result describing the skill that is furthest from the configured
+ * target level. Kept free of RuneLite dependencies so the ranking logic can be
+ * smoke-tested without a live client.
+ */
+final class SkillNemesisAnalysis
+{
+	private final String skillName;
+	private final int level;
+	private final int targetLevel;
+	private final int gap;
+
+	SkillNemesisAnalysis(String skillName, int level, int targetLevel)
+	{
+		this.skillName = Objects.requireNonNull(skillName, "skillName");
+		this.level = level;
+		this.targetLevel = targetLevel;
+		this.gap = Math.max(0, targetLevel - level);
+	}
+
+	String getSkillName()
+	{
+		return skillName;
+	}
+
+	int getLevel()
+	{
+		return level;
+	}
+
+	int getTargetLevel()
+	{
+		return targetLevel;
+	}
+
+	int getGap()
+	{
+		return gap;
+	}
+
+	boolean isAtOrAboveTarget()
+	{
+		return gap == 0;
+	}
+
+	String toChatMessage()
+	{
+		if (isAtOrAboveTarget())
+		{
+			return "SkillNemesis: all tracked skills are at or above your target level of " + targetLevel + ".";
+		}
+
+		return "SkillNemesis: your current nemesis is " + skillName + " (level " + level
+			+ ", " + gap + " below target " + targetLevel + ").";
+	}
+}
