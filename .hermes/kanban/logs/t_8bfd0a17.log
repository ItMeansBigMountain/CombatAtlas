+package com.itmeansbigmountain.skillnemesis;
+
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Ranks skills against a target level and chooses the largest deficit as the
+ * player's "nemesis". This class intentionally has no RuneLite dependencies;
+ * the plugin adapts RuneLite Skill values into the simple inputs here.
+ */
+final class SkillNemesisAnalyzer
+{
+	private SkillNemesisAnalyzer()
+	{
+		// Utility class.
+	}
+
+	static SkillNemesisAnalysis findNemesis(List<SkillLevel> levels, int targetLevel)
+	{
+		if (levels == null || levels.isEmpty())
+		{
+			throw new IllegalArgumentException("levels must not be empty");
+		}
+
+		SkillLevel weakest = null;
+		int largestGap = Integer.MIN_VALUE;
+
+		for (SkillLevel level : levels)
+		{
+			Objects.requireNonNull(level, "level");
+			int gap = targetLevel - level.getLevel();
+			if (weakest == null || gap > largestGap || (gap == largestGap && level.getLevel() < weakest.getLevel()))
+			{
+				weakest = level;
+				largestGap = gap;
+			}
+		}
+
+		return new SkillNemesisAnalysis(weakest.getSkillName(), weakest.getLevel(), targetLevel);
+	}
+
+	static final class SkillLevel
+	{
+		private final String skillName;
+		private final int level;
+
+		SkillLevel(String skillName, int level)
+		{
+			this.skillName = Objects.requireNonNull(skillName, "skillName");
+			this.level = level;
+		}
+
+		String getSkillName()
+		{
+			return skillName;
+		}
+
+		int getLevel()
+		{
+			return level;
+		}
+	}
+}
