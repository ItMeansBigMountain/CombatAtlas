+	private final NearbyPlayerSnapshotConfig config = new NearbyPlayerSnapshotConfig()
+	{
+	};
+
+	@Test
+	public void defaultSettingsAreSafeForFirstLaunch()
+	{
+		assertTrue(config.showOverlay());
+		assertFalse(config.includeSelf());
+		assertEquals(15, config.maxDistance());
+		assertEquals(8, config.maxPlayers());
+	}
