 package com.itmeansbigmountain.skillstreaks;
 
+import net.runelite.api.Skill;
 import net.runelite.client.RuneLite;
 import net.runelite.client.externalplugins.ExternalPluginManager;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
 
 public class SkillStreaksPluginTest
 {
+	@Test
+	public void tracksConsecutiveXpGainsInSameSkill()
+	{
+		SkillStreaksPlugin plugin = new SkillStreaksPlugin();
+
+		SkillStreaksPlugin.StreakUpdate first = plugin.recordXpGain(Skill.MINING, 1_000, false);
+		SkillStreaksPlugin.StreakUpdate second = plugin.recordXpGain(Skill.MINING, 1_125, false);
+		SkillStreaksPlugin.StreakUpdate third = plugin.recordXpGain(Skill.MINING, 1_250, false);
+
+		assertEquals(Skill.MINING, first.getSkill());
+		assertEquals(1, first.getCurrentStreak());
+		assertEquals(0, first.getXpGained());
+		assertEquals(2, second.getCurrentStreak());
+		assertEquals(125, second.getXpGained());
+		assertEquals(3, third.getCurrentStreak());
+		assertEquals(3, third.getBestStreak());
+	}
+
+	@Test
+	public void resetsCurrentStreakWhenSkillChanges()
+	{
+		SkillStreaksPlugin plugin = new SkillStreaksPlugin();
+
+		plugin.recordXpGain(Skill.WOODCUTTING, 500, false);
+		plugin.recordXpGain(Skill.WOODCUTTING, 550, false);
+		SkillStreaksPlugin.StreakUpdate changed = plugin.recordXpGain(Skill.FIREMAKING, 700, false);
+
+		assertEquals(Skill.FIREMAKING, changed.getSkill());
+		assertEquals(1, changed.getCurrentStreak());
+		assertEquals(2, changed.getBestStreak());
+		assertEquals(0, changed.getXpGained());
+	}
+
+	@Test
+	public void ignoresOverallByDefault()
+	{
+		SkillStreaksPlugin plugin = new SkillStreaksPlugin();
+
+		assertFalse(SkillStreaksPlugin.shouldTrack(Skill.OVERALL, false));
+		assertTrue(SkillStreaksPlugin.shouldTrack(Skill.OVERALL, true));
+		assertNull(plugin.recordXpGain(Skill.OVERALL, 10_000, false));
+	}
+
 	public static void main(String[] args) throws Exception
 	{
 		ExternalPluginManager.loadBuiltin(SkillStreaksPlugin.class);
 		RuneLite.main(args);
