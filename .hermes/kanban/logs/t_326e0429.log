+package com.itmeansbigmountain.friendprogressfeed;
+
+import java.text.NumberFormat;
+import java.util.Locale;
+
+final class FriendProgressFeedFormatter
+{
+	private static final NumberFormat NUMBER_FORMAT = NumberFormat.getIntegerInstance(Locale.US);
+
+	private FriendProgressFeedFormatter()
+	{
+	}
+
+	static boolean shouldAnnounceXpDrop(int previousXp, int currentXp, int minimumXpDrop)
+	{
+		if (previousXp < 0 || currentXp <= previousXp)
+		{
+			return false;
+		}
+
+		return currentXp - previousXp >= Math.max(1, minimumXpDrop);
+	}
+
+	static boolean shouldAnnounceLevel(int previousLevel, int currentLevel)
+	{
+		return previousLevel > 0 && currentLevel > previousLevel;
+	}
+
+	static String formatXpDrop(String playerName, String skillName, int gainedXp)
+	{
+		return playerName + " gained " + NUMBER_FORMAT.format(gainedXp) + " " + skillName + " XP.";
+	}
+
+	static String formatLevelUp(String playerName, String skillName, int level)
+	{
+		return playerName + " reached " + skillName + " level " + level + ".";
+	}
+
+	static String displayName(String rawName)
+	{
+		if (rawName == null || rawName.trim().isEmpty())
+		{
+			return "A friend";
+		}
+
+		return rawName.trim();
+	}
+}
