+package com.itmeansbigmountain.achievementgapfinder;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Small, RuneLite-independent helper for comparing achievement checklists.
+ *
+ * RuneLite does not expose every account achievement/diary/combat achievement as
+ * a simple public API, so the plugin starts with a player-maintained checklist:
+ * paste the target player's achievements and your completed achievements into
+ * config, then this class returns the ordered gap.
+ */
+final class AchievementGapReport
+{
+	private AchievementGapReport()
+	{
+	}
+
+	static List<String> parseList(String raw)
+	{
+		if (raw == null || raw.trim().isEmpty())
+		{
+			return Collections.emptyList();
+		}
+
+		String[] parts = raw.split("[,\\n]");
+		Set<String> normalized = new LinkedHashSet<>();
+		for (String part : parts)
+		{
+			String item = part.trim();
+			if (!item.isEmpty())
+			{
+				normalized.add(item);
+			}
+		}
+		return new ArrayList<>(normalized);
+	}
+
+	static List<String> findMissing(String targetAchievements, String completedAchievements)
+	{
+		List<String> target = parseList(targetAchievements);
+		List<String> completed = parseList(completedAchievements);
+		Set<String> completedKeys = new LinkedHashSet<>();
+		for (String item : completed)
+		{
+			completedKeys.add(key(item));
+		}
+
+		List<String> missing = new ArrayList<>();
+		for (String item : target)
+		{
+			if (!completedKeys.contains(key(item)))
+			{
+				missing.add(item);
+			}
+		}
+		return missing;
+	}
+
+	static String summarize(String targetAchievements, String completedAchievements, int limit)
+	{
+		List<String> missing = findMissing(targetAchievements, completedAchievements);
+		if (missing.isEmpty())
+		{
+			return "Achievement Gap Finder: no configured gaps found.";
+		}
+
+		int safeLimit = Math.max(1, limit);
+		List<String> shown = missing.subList(0, Math.min(safeLimit, missing.size()));
+		String summary = "Achievement Gap Finder: " + missing.size() + " missing - " + String.join(", ", shown);
+		int remaining = missing.size() - shown.size();
+		if (remaining > 0)
+		{
