+package com.itmeansbigmountain.bossstreaks;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.time.LocalDate;
+import java.util.Optional;
+import org.junit.Test;
+
+public class BossStreaksTrackerTest
+{
+	@Test
+	public void parseKillCountMessageRecognizesBossNameAndCount()
+	{
+		Optional<BossStreaksTracker.BossKill> kill = BossStreaksTracker.parseKillCountMessage("Your Zulrah kill count is: 150");
+
+		assertTrue(kill.isPresent());
+		assertEquals("Zulrah", kill.get().getBossName());
+		assertEquals(150, kill.get().getKillCount());
+	}
+
+	@Test
+	public void parseKillCountMessageIgnoresUnrelatedChat()
+	{
+		Optional<BossStreaksTracker.BossKill> kill = BossStreaksTracker.parseKillCountMessage("Welcome to Old School RuneScape.");
+
+		assertFalse(kill.isPresent());
+	}
+
+	@Test
+	public void recordKillStartsAndExtendsDailyStreaksWithoutDoubleCountingSameDay()
+	{
+		BossStreaksTracker tracker = new BossStreaksTracker();
+
+		BossStreaksTracker.StreakUpdate first = tracker.recordKill("zulrah", LocalDate.of(2026, 5, 1));
+		BossStreaksTracker.StreakUpdate duplicate = tracker.recordKill("Zulrah", LocalDate.of(2026, 5, 1));
+		BossStreaksTracker.StreakUpdate nextDay = tracker.recordKill("Zulrah", LocalDate.of(2026, 5, 2));
+
+		assertEquals(1, first.getCurrentStreakDays());
+		assertTrue(first.isNewStreakDay());
+		assertEquals(1, duplicate.getCurrentStreakDays());
+		assertFalse(duplicate.isNewStreakDay());
+		assertEquals(2, nextDay.getCurrentStreakDays());
+		assertTrue(nextDay.isNewStreakDay());
+	}
+
+	@Test
+	public void recordKillResetsStreakAfterMissedDay()
+	{
+		BossStreaksTracker tracker = new BossStreaksTracker();
+
+		tracker.recordKill("Vorkath", LocalDate.of(2026, 5, 1));
+		BossStreaksTracker.StreakUpdate update = tracker.recordKill("Vorkath", LocalDate.of(2026, 5, 3));
+
+		assertEquals(1, update.getCurrentStreakDays());
+		assertTrue(update.isNewStreakDay());
+	}
+}
