+package com.itmeansbigmountain.bossstreaks;
+
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Optional;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Small, client-free streak engine so BossStreaks behavior can be unit tested
+ * without launching RuneLite.
+ */
+class BossStreaksTracker
+{
+	private static final Pattern KILL_COUNT_MESSAGE = Pattern.compile("^Your (.+?) kill count is: ([0-9,]+)\\.?$", Pattern.CASE_INSENSITIVE);
+
+	private final Map<String, BossStreak> streaks = new HashMap<>();
+
+	static Optional<BossKill> parseKillCountMessage(String message)
+	{
+		if (message == null)
+		{
+			return Optional.empty();
+		}
+
+		Matcher matcher = KILL_COUNT_MESSAGE.matcher(message.trim());
+		if (!matcher.matches())
+		{
+			return Optional.empty();
+		}
+
+		String bossName = matcher.group(1).trim();
+		int killCount = Integer.parseInt(matcher.group(2).replace(",", ""));
+		return Optional.of(new BossKill(bossName, killCount));
+	}
+
+	StreakUpdate recordKill(String bossName, LocalDate killDate)
+	{
+		String normalizedBossName = normalizeBossName(bossName);
+		BossStreak current = streaks.get(normalizedBossName);
+
+		if (current == null)
+		{
+			BossStreak created = new BossStreak(displayBossName(bossName), killDate, 1);
+			streaks.put(normalizedBossName, created);
+			return new StreakUpdate(created.getBossName(), created.getCurrentStreakDays(), true);
+		}
+
+		if (killDate.equals(current.getLastKillDate()))
+		{
+			return new StreakUpdate(current.getBossName(), current.getCurrentStreakDays(), false);
+		}
+
+		long daysSinceLastKill = ChronoUnit.DAYS.between(current.getLastKillDate(), killDate);
+		int nextStreak = daysSinceLastKill == 1 ? current.getCurrentStreakDays() + 1 : 1;
+		BossStreak updated = new BossStreak(current.getBossName(), killDate, nextStreak);
+		streaks.put(normalizedBossName, updated);
+		return new StreakUpdate(updated.getBossName(), updated.getCurrentStreakDays(), true);
+	}
+
+	void clear()
+	{
+		streaks.clear();
+	}
+
+	private static String normalizeBossName(String bossName)
+	{
+		return bossName.trim().toLowerCase(Locale.ROOT);
+	}
+
+	private static String displayBossName(String bossName)
+	{
+		String trimmed = bossName.trim();
+		if (trimmed.isEmpty())
