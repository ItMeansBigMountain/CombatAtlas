from PIL import Image, ImageDraw
from pathlib import Path
imgs=[]
for p in sorted(Path('qa_frames').glob('*.png')):
    im=Image.open(p).resize((320,180))
    imgs.append((p.name,im))
w,h=4*320,3*210
out=Image.new('RGB',(w,h),(8,11,18))
d=ImageDraw.Draw(out)
for idx,(name,im) in enumerate(imgs):
    x=(idx%4)*320; y=(idx//4)*210
    out.paste(im,(x,y))
    d.text((x+8,y+184),name,fill=(220,230,245))
out.save('final_contact_sheet.png')
