# Discord gateway setup for Hermes Agent
# Copy these into /opt/data/.env after creating a Discord bot.
# Required:
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Optional: delivery/home channel for cron/background messages.
# Get channel ID from Discord Developer Mode -> right-click channel -> Copy Channel ID.
# DISCORD_HOME_CHANNEL=123456789012345678
# DISCORD_HOME_CHANNEL_NAME=Home

# Optional: restrict who can use the bot by Discord user ID(s), comma-separated.
# Strongly recommended if the bot is in a shared server.
# DISCORD_ALLOWED_USERS=111111111111111111,222222222222222222

# Optional: let the bot respond without @mentions in listed channels.
# DISCORD_FREE_RESPONSE_CHANNELS=123456789012345678

# Optional: restrict bot to listed channel IDs only.
# DISCORD_ALLOWED_CHANNELS=123456789012345678,234567890123456789
