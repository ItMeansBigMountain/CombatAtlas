# Keep the backup repo from accidentally publishing local secrets or volatile runtime files.
# The .hermes/ directory itself is intentionally tracked as a sanitized backup.

# Secrets / credentials
.env
.env.*
!.env.example
!.env.*.template
.git-credentials
.netrc
**/.env
**/.env.*
!**/.env.example
!**/.env.*.template
**/*secret*
**/*token*
**/*credential*
**/*service_account*.json
**/google_service_account.json
**/cred.json
**/auth.json
**/auth.lock
**/auth-*.json
**/oauth*.json
**/keyring*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Runtime locks / pids / sockets
*.lock
*.pid
*.sock
*.log
**/.tick.lock
/projects/KANBAN_SWEEP_DISPATCH.log

# Caches and transient build artifacts

# Sanitized backup should not track local caches, browser binaries, package caches, SDKs, session logs, or DB snapshots
/.hermes/.cache/
/.hermes/.config/
/.hermes/.npm/
/.hermes/.gradle/
/.hermes/.local/
/.hermes/.expo/
/.hermes/jdks/
/.hermes/tmp/
/.hermes/bin/
/.hermes/cache/
/.hermes/lsp/
/.hermes/logs/
/.hermes/sessions/
/.hermes/audio_cache/
/.hermes/state-snapshots/
/.hermes/ibmcloud-cli/
/.hermes/hermes-agent/
/.hermes/credentials/
/.hermes/secrets/
/.hermes/models_dev_cache.json
/.hermes/state.db
/.hermes/**/*.db
/.hermes/**/*.sqlite
/.hermes/**/*.sqlite3
/.hermes/**/.venv/
/.hermes/**/venv/
/.hermes/**/node_modules/
/.hermes/**/dist/
/.hermes/**/build/
/.hermes/**/web_dist/
/.hermes/**/.next/
/.hermes/**/.nuxt/
/.hermes/**/__pycache__/
/.hermes/**/*.egg-info/

**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.expo/
**/.next/
**/.nuxt/
**/node_modules/
**/dist/
**/build/
**/coverage/
**/db.sqlite3
**/*.sqlite3
**/.DS_Store
**/Thumbs.db

# Git internals from nested repos/backups
**/.git/

# Original root-owned source copy after legacy project import; active copies live under /projects/
/legacy-projects/

# Imported raw aggregate archive; active project copies live in top-level /projects folders
/projects/legacy-src/

# Nested standalone Git repos managed separately
/projects/algos/
/projects/az204/
/projects/cox-elementary-pta/
/projects/robinhood-daily-portfolio-report/
