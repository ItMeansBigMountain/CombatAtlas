# Keep the backup repo from accidentally publishing local secrets or volatile runtime files.
# The .hermes/ directory itself is intentionally tracked as a sanitized backup.

# Secrets / credentials
.env
.env.*
!.env.example
!.env.*.template
.git-credentials
.netrc
**/.env
**/.env.*
!**/.env.example
!**/.env.*.template
**/*secret*
**/*token*
**/*credential*
**/auth.json
**/auth.lock
**/auth-*.json
**/oauth*.json
**/keyring*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Runtime locks / pids / sockets
*.lock
*.pid
*.sock
**/.tick.lock

# Caches and transient build artifacts

# Sanitized backup should not track local caches, browser binaries, package caches, or DB snapshots
/.hermes/.cache/
/.hermes/.config/
/.hermes/.npm/
/.hermes/.local/share/pki/
/.hermes/state.db
/.hermes/**/*.db
/.hermes/**/*.sqlite
/.hermes/**/*.sqlite3

**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.expo/
**/.next/
**/.nuxt/
**/node_modules/
**/dist/
**/build/
**/coverage/
**/db.sqlite3
**/*.sqlite3
**/.DS_Store
**/Thumbs.db

# Git internals from nested repos/backups
**/.git/

# Original root-owned source copy after legacy project import; active copies live under /projects/
/legacy-projects/

# Imported raw aggregate archive; active project copies live in top-level /projects folders
/projects/legacy-src/

# Nested standalone Git repos managed separately
/projects/algos/
/projects/az204/
/projects/cox-elementary-pta/
/projects/robinhood-daily-portfolio-report/
