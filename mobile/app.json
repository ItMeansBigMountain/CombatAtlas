{
  "expo": {
    "name": "CombatAtlas",
    "slug": "combatatlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "combatatlas",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itmeansbigmountain.combatatlas",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "CombatAtlas only requests tracking permission if personalized advertising is enabled."
      }
    },
    "android": {
      "package": "com.itmeansbigmountain.combatatlas"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "adsMode": "test-only-until-production-ids-are-configured",
      "eas": {
        "projectId": "ba4964b4-58c0-454b-9f07-8b7f7ea8949c"
      }
    },
    "owner": "sosai.oyama"
  }
}
