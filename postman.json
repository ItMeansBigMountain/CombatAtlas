{
  "info": {
    "name": "Combat Atlas API",
    "_postman_id": "combat-atlas-v2",
    "description": "Full API testing collection for Combat Atlas backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Martial Arts",
      "item": [
        {
          "name": "Get All Martial Arts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/martialarts/"
          }
        },
        {
          "name": "Get Martial Art By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/martialarts/1/"
          }
        },
        {
          "name": "Get Categories For Martial Art",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/martialarts/1/categories/"
          }
        },
        {
          "name": "Create Martial Art",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Boxing\",\n  \"sport_type\": \"Striking\",\n  \"description\": \"Western boxing drills\"\n}"
            },
            "url": "{{base_url}}/martialarts/"
          }
        }
      ]
    },
    {
      "name": "Drill Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillcategories/"
          }
        },
        {
          "name": "Get Exercises For Category",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillcategories/1/exercises/"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Footwork\",\n  \"martial_art\": 1,\n  \"description\": \"Footwork drills\"\n}"
            },
            "url": "{{base_url}}/drillcategories/"
          }
        }
      ]
    },
    {
      "name": "Drill Exercises",
      "item": [
        {
          "name": "Get All Drills",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillexercises/"
          }
        },
        {
          "name": "Get Random Drill (All)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillexercises/random/"
          }
        },
        {
          "name": "Get Random Drill By Martial Art",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillexercises/random/?martial_art=1"
          }
        },
        {
          "name": "Get Random Drill By Category",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/drillexercises/random/?category=1"
          }
        },
        {
          "name": "Create Drill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Slip Counter Drill\",\n  \"difficulty_level\": \"Intermediate\",\n  \"drill_type\": \"Reaction\",\n  \"category\": 1,\n  \"description\": \"Slip and counter drill\"\n}"
            },
            "url": "{{base_url}}/drillexercises/"
          }
        }
      ]
    }
  ]
}
