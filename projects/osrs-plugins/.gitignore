# Each child directory here is an independent RuneLite plugin git repo.
# Do not track plugin internals in the parent HeRmEz workspace repository.
*/
!.gitignore
!README.md
!_templates/
!_templates/*
!completed/
!completed/.gitkeep
!pr-review-pending/
!pr-review-pending/.gitkeep
!in-progress/
!in-progress/.gitkeep

# Registered submodule gitlinks are durable parent-repository metadata.
!completed/BisLoadouts
!completed/DeadmanBreachTimer
!in-progress/ClanWarBoard
!pr-review-pending/WhosGrindingClanPanel
!services/
!services/clan-war-board-service
