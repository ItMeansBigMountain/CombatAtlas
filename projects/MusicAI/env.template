# Azure Infrastructure
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_LOCATION=Central US

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=http://localhost:5000/login/

# SoundCloud API (OAuth 2.1 + PKCE)
# Create/manage app at https://developers.soundcloud.com/ (Artist Pro required by SoundCloud)
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
SOUNDCLOUD_CALLBACK_URL=http://localhost:5000/providers/soundcloud/callback

# Genius API (Direct API key - no OAuth needed)
GENIUS_API_KEY=your_genius_api_key_here

# IBM Watson NLU
WATSON_API_KEY=your_watson_api_key
WATSON_SERVICE_URL=your_watson_service_url

# Flask App
FLASK_SECRET_KEY=your_flask_secret_key_here
MUSICAI_TOKEN_SECRET=your_long_random_token_encryption_secret
# Durable real-user storage. Use Vercel Postgres/Neon/Supabase Postgres in production.
MUSICAI_DATABASE_URL=postgresql://user:password@host:5432/musicai?sslmode=require
# Compatibility alias accepted by token_store; use a Postgres URL in production, not a file path.
MUSICAI_TOKEN_DB=postgresql://user:password@host:5432/musicai?sslmode=require
# Local-only SQLite fallback; on Vercel /tmp is ephemeral and not for real users.
MUSICAI_SQLITE_PATH=/tmp/musicai_tokens.db
FLASK_ENV=development
FLASK_DEBUG=true

# App Configuration
APP_NAME=musicai
ENV=dev
CONTAINER_PORT=8080

# Imgflip API (for meme generation)
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password
