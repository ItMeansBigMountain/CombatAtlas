{
  "expo": {
    "name": "BurnoutBoyz",
    "slug": "burnoutboyz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "burnoutboyz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.burnoutboyz.manual",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph an optional maintenance receipt for your records.",
        "NSFaceIDUsageDescription": "Protect connected-car credentials stored on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
      ,"package": "com.burnoutboyz.manual"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", {"configureAndroidBackup": true, "faceIDPermission": "Protect connected-car credentials stored on this device."}],
      ["expo-image-picker", {"cameraPermission": "Photograph an optional maintenance receipt for your records.", "photosPermission": "Select an optional maintenance receipt for your records."}],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
