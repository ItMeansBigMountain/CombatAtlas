{
  "openapi": "3.0.0",
  "info": {
    "title": "Chat Session API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://reasonably-fit-impala.ngrok-free.app"
    }
  ],
  "paths": {
    "/chats/": {
      "get": {
        "summary": "List all chat sessions",
        "operationId": "listChatSessions",
        "parameters": [
          {
            "name": "unique_identifier",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of chat sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatSession"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new chat session",
        "operationId": "createChatSession",
        "parameters": [
          {
            "name": "unique_identifier",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSession"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A new chat session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{sessionId}/": {
      "get": {
        "summary": "Retrieve a chat session",
        "operationId": "getChatSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unique_identifier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A single chat session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a chat session",
        "operationId": "updateChatSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unique_identifier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated chat session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      }
    },
    "/privacy-policy/": {
      "get": {
        "summary": "Retrieve the privacy policy",
        "operationId": "privacyPolicy",
        "description": "Returns the privacy policy of the application as a JSON object.",
        "responses": {
          "200": {
            "description": "A JSON object containing the privacy policy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Introduction": {
                      "type": "string"
                    },
                    "Data Collection and Use": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-profiles/": {
      "get": {
        "summary": "List all user profiles",
        "operationId": "listUserProfiles",
        "responses": {
          "200": {
            "description": "A list of user profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserProfile"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatSession": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "user_id": {
            "type": "integer"
          },
          "session_data": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
            "tokenUrl": "https://oauth2.googleapis.com/token",
            "scopes": {
              "https://www.googleapis.com/auth/userinfo.email": "Access user email"
            }
          }
        }
      }
    }
  }
}