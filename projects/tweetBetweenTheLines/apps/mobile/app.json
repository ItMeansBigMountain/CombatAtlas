{
  "expo": {
    "name": "tweetBetweenTheLines",
    "slug": "tweet-between-the-lines",
    "scheme": "tweetbetweenthelines",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "bundleIdentifier": "com.tweetbetweenthelines.app",
      "associatedDomains": [
        "applinks:app.tweetbetweenthelines.com"
      ]
    },
    "android": {
      "package": "com.tweetbetweenthelines.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.tweetbetweenthelines.com",
              "pathPrefix": "/oauth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Authenticate to manage your private data."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-font"
    ]
  }
}
